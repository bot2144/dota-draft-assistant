# Optional. Copy to .env and fill in to seed the AI provider on first run
# only (Settings → AI Provider always takes precedence once configured
# there, and the app works perfectly with none of this set — it just runs
# on the local analysis engine only). Never commit a real .env file.

# VITE_AI_PROVIDER=anthropic
# VITE_AI_API_KEY=sk-ant-...
# VITE_AI_MODEL=claude-sonnet-5

# For a local OpenAI-compatible server instead:
# VITE_AI_PROVIDER=compatible
# VITE_AI_BASE_URL=http://localhost:1234/v1
